# --- Aplikacja ---
NODE_ENV=development
PORT=3000
# Publiczny adres aplikacji (linki w mailach, OG tags, Better Auth)
APP_URL=http://localhost:5173

# --- Baza ---
DATABASE_URL=postgresql://wedding:wedding@localhost:5442/wedding

# --- Auth (openssl rand -base64 32) ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Mail ---
# Dev: Mailpit (http://localhost:8035)
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true, SMTP_PASS = hasło aplikacji
SMTP_HOST=localhost
SMTP_PORT=1035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wedding Planner <no-reply@example.com>"

# --- Pliki (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=wedding
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
